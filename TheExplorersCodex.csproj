<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>2.3.0.0</Version>
    <!-- Manifest-Felder (siehe https://github.com/goatcorp/DalamudPackager) -->
    <Author>Stoni</Author>
    <Name>The Explorer's Codex</Name>
    <Punchline>Zone Completion, inspired by "All the Things" from WoW</Punchline>
    <Description>Completionist plugin per zone with automation capabilities.</Description>
    <RepoUrl>https://github.com/stoni89/explorers-codex</RepoUrl>
    <Tags>collection;tracker;utility;explorerscodex</Tags>
    <!-- Icon im Dalamud-Plugin-Installer (Dev Plugins-Liste) statt Platzhalter - wird als URL geladen, deshalb der rohe GitHub-Link statt eines lokalen Pfads. -->
    <IconUrl>https://raw.githubusercontent.com/stoni89/explorers-codex/main/Data/icon.png</IconUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Liefert vorberechnete NPC<->Shop- und NPC<->Position-Zuordnungen (ENpcShop/ENpcPlace), die
         aus Square Enix' eigenen Rohdaten allein nicht sauber auflösbar sind - für die Händler-
         Auflösung bei per Framer's-Kit-Item kaufbaren Portrait-Rahmen (siehe Plugin.EnrichFrameKitVendors).
         Dieselbe Version, die auch das Dalamud-Plugin "Collections" nutzt. -->
    <PackageReference Include="LuminaSupplemental.Excel" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Das aus diesem Projekt herausgelöste, wiederverwendbare UI-Paket (siehe
         C:\FF14Mods\PluginUiKit\README.md) - CodexTheme.cs/CodexWidgets.cs sind nur noch eine dünne
         Weiterleitungsschicht darauf, keine eigene Implementierung mehr. -->
    <ProjectReference Include="..\PluginUiKit\PluginUiKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Data\mounts.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\minions.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\orchestrions.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\bardings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\emotes.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\facewear.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\fashions.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\triadcards.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\aethercurrents.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Changelog.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Schriften für das neue Codex-Design (siehe NewDesign/DESIGN_SPEC.md Abschnitt 3) - Google
         Fonts, SIL Open Font License, dürfen mit dem Plugin ausgeliefert werden (Lizenztexte liegen
         jeweils daneben). -->
    <None Include="Data\Fonts\Cinzel.ttf" CopyToOutputDirectory="PreserveNewest" />
    <!-- Echte statische Bold-Variante (Google Fonts CDN liefert sie trotz variablem Haupt-Font auch
         einzeln aus) - die variable Cinzel.ttf lädt ohne Achsen-Auswahl nur in ihrem Standardgewicht,
         nie wirklich fett (Nutzer-Report: Titel sollte Bold sein). -->
    <None Include="Data\Fonts\Cinzel-Bold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Fonts\Alegreya.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Fonts\AlegreyaItalic.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Fonts\AlegreyaSans-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Fonts\AlegreyaSans-Medium.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Fonts\AlegreyaSans-Bold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Fonts\OFL-Cinzel.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Fonts\OFL-Alegreya.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Data\Fonts\OFL-AlegreyaSans.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
